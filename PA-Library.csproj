<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>PA_Library</RootNamespace>
  </PropertyGroup>
    <!--<PackageReference Include="System.Collections.Immutable" Version="9.0.2" />-->
  <ItemGroup>
    <!-- <Reference Include="Microsoft.CSharp">
      <RequiredTargetFramework>3.5</RequiredTargetFramework>
    </Reference> -->
    <!-- <Reference Include="System.Core">
      <RequiredTargetFramework>3.5</RequiredTargetFramework>
    </Reference> -->
    <Reference Include="System.Runtime.InteropServices">
      <RequiredTargetFramework>netstandard2.0</RequiredTargetFramework>
    </Reference>
      <!-- <Exec ToolPath=""  -->
      <!-- <Exec Command="msbuild.exe"/> -->
      <!-- <CSC Sources="@Compile" OutputAssembly="$(AppName).dll" EmitDebugInformation="true"/> -->
    <!-- </Target> -->
    <Target Name="Assemble">
      <Message Text="Assemble"/>
    </Target>
    <PropertyGroup>
        <Flavor Condition="'$(Flavor)'==''">DEBUG</Flavor>
    </PropertyGroup>

    <!-- Define DEBUG settings -->
    <PropertyGroup Condition="'$(Flavor)'=='DEBUG'">
        <DebugType>full</DebugType>
        <Optimize>no</Optimize>
    </PropertyGroup>

    <!-- Define RETAIL settings -->
    <PropertyGroup Condition="'$(Flavor)'=='RETAIL'">
        <DebugType>pdbonly</DebugType>
        <Optimize>yes</Optimize>
    </PropertyGroup>

    <!-- Set application name as a property -->
    <PropertyGroup>
        <appname>HelloWorldCS</appname>
    </PropertyGroup>

    <!-- Specify inputs by type and file name -->
    <ItemGroup>
        <CSFile Include = "PACount.cs"/>
        <CSFile Include = "PAData.cs"/>
        <CSFile Include = "PAElement.cs"/>
        <CSFile Include = "PAInput.cs"/>
        <CSFile Include = "PALink.cs"/>
        <CSFile Include = "PAList.cs"/>
        <CSFile Include = "PANode.cs"/>
        <CSFile Include = "PANormalTree.cs"/>
        <CSFile Include = "PANumber.cs"/>
        <CSFile Include = "PAOutput.cs"/>
        <CSFile Include = "PAPair.cs"/>
        <CSFile Include = "PAResource.cs"/>
        <CSFile Include = "PAResult.cs"/>
        <CSFile Include = "PASeries.cs"/>
        <CSFile Include = "PAStatus.cs"/>
        <CSFile Include = "PATransposeTree.cs"/>
        <CSFile Include = "PATree.cs"/>
        <CSFile Include = "IStateConstruct.cs"/>
        <CSFile Include = "IStateInitialise.cs"/>
        <CSFile Include = "IStateDelete.cs"/>
        <CSFile Include = "IStateFinish.cs"/>
        <CSFile Include = "IStateMachine.cs"/>
    </ItemGroup>

    <Target Name = "Compile">
        <Message Text="Compile"/>
        <!-- Run Visual C# compilation using input file of type CSFile -->
        <CSC  Sources = "@(CSFile)"
            OutputAssembly="$(appname).exe" >
            <!-- Optimize="$(Optimize)" -->
            <!-- DebugType="$(DebugType)" -->

            <!-- Set OutputAssembly attribute of CSC task to name of created executable file -->
            <Output TaskParameter="OutputAssembly"
                ItemName = "EXEFile" />
        </CSC>
        <!-- Log file name of output file -->
        <Message Text="The output file is @(EXEFile)"/>
    </Target>
      
    <Target Name="Link">
      <Message Text="Link"/>
    </Target>

    <Target Name="Test">
      <Message Text="Test"/>
    </Target>

    <!-- <Reference Include="System.Xml.Linq">
      <RequiredTargetFramework>3.5</RequiredTargetFramework>
    </Reference> -->
  </ItemGroup>
</Project>
