<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworkVersion>net40</TargetFrameworkVersion>
    <Configuration>Debug</Configuration>
    <Platform>AnyCPU</Platform>
    <BaseOutputPath></BaseOutputPath>
    <OutputPath></OutputPath>
    <builtdir>dll</builtdir>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>PA_Library</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" Version="9.0.2" />
  </ItemGroup>

  <Target Name="Clean">
    <Message Text="Cleaning"></Message>
    <RemoveDir Directories="$(builtdir)"/>
  </Target>
  <Target Name="Build">
    <Message Text="Build"></Message>
    <MakeDir Directories= "$(builtdir)" Condition ="!Exists('$(builtdir)')"/>
    <CSC Sources= "@(CSFile" OutputAssembly="$(BuiltDir\$(appname).exe">
      <Output TaskParameter="OutputAssembly" ItemName = "EXEFile"/>
    </CSC>
  </Target>



</Project>
